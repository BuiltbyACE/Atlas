{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.safaristack.co.ke/schemas/events/core.notification.sent.v1.schema.json",
  "title": "core.notification.sent.v1",
  "description": "A notification was delivered by a channel adapter (docs/ATLAS.md §6.4, §7.4). Emitted by the dispatcher after a successful provider call.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipient_person_id", "notification_id", "provider", "sent_at"],
  "properties": {
    "recipient_person_id": {
      "type": "string",
      "format": "uuid"
    },
    "notification_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
