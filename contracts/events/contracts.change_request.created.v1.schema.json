{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.safaristack.co.ke/schemas/events/contracts.change_request.created.v1.schema.json",
  "title": "contracts.change_request.created.v1",
  "description": "A change request was raised against a contract (docs/ATLAS.md §8.3).",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_request_id", "ref", "contract_id", "status", "occurred_at"],
  "properties": {
    "change_request_id": { "type": "string", "format": "uuid" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 60 },
    "contract_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "maxLength": 40 },
    "actor_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
