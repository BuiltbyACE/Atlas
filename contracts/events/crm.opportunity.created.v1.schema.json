{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atlas.safaristack.co.ke/schemas/events/crm.opportunity.created.v1.schema.json",
  "title": "crm.opportunity.created.v1",
  "description": "An opportunity was created (docs/ATLAS.md §8.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["opportunity_id", "ref", "stage_key", "occurred_at"],
  "properties": {
    "opportunity_id": { "type": "string", "format": "uuid" },
    "ref": { "type": "string", "minLength": 1, "maxLength": 60 },
    "stage_key": { "type": "string", "maxLength": 60 },
    "owner_person_id": { "type": "string", "format": "uuid" },
    "owner_user_id": { "type": "string", "format": "uuid" },
    "actor_id": { "type": "string", "format": "uuid" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
