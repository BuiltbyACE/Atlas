# Atlas web environment.
# Copy to `.env.local` for development. Never commit real secrets.

# Public base URL used by BROWSER code (client components / realtime).
# Leave EMPTY to use the same origin: Caddy routes /api/* to the Go service in
# production, so the browser should call /api/v1/... relative to Atlas.
NEXT_PUBLIC_API_BASE_URL=

# Internal URL used by NEXT.JS SERVER COMPONENTS to reach the Go API over the
# private network, forwarding the user's session cookie.
ATLAS_API_INTERNAL_URL=http://localhost:8080

# Phoenix Channels WebSocket endpoint. Production proxies /socket through Caddy,
# so the default of /socket (same origin) is usually correct. In development,
# point this at the orchestrator (for example http://localhost:4000/socket).
NEXT_PUBLIC_REALTIME_URL=/socket
