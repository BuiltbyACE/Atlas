# ─────────────────────────────────────────────────────────────
# Atlas — local development environment
# Copy to `.env` and adjust. NEVER commit a real `.env`.
#   PowerShell:  Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
# NOTE: Atlas deliberately does NOT use host port 5432 — that is commonly
# taken by another local Postgres/container. 55433 keeps Atlas isolated.
POSTGRES_HOST=localhost
POSTGRES_PORT=55433
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas

# Dedicated database roles created by infra/compose/postgres/initdb.d/01-roles.sh
ATLAS_API_DB_PASSWORD=atlas_api
ATLAS_ORCHESTRATOR_DB_PASSWORD=atlas_orchestrator
ATLAS_WORKER_DB_PASSWORD=atlas_worker
ATLAS_READONLY_DB_PASSWORD=atlas_readonly
ATLAS_MIGRATOR_DB_PASSWORD=atlas_migrator

# ── Object storage (SeaweedFS locally; S3-compatible in staging/prod) ──
# Local: SeaweedFS. MinIO community images were removed from Docker Hub in
# Sept 2026; see docs/adr/ADR-015-object-storage-provider.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=atlas
S3_SECRET_KEY=atlasminio
S3_BUCKET=atlas-files
S3_USE_SSL=false

# ── Email (Mailpit locally) ──────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=atlas@localhost

# ── Go core API (atlas-api / atlas-worker) ───────────────────
ATLAS_ENV=local
ATLAS_HTTP_ADDR=:8080
ATLAS_LOG_LEVEL=debug
ATLAS_LOG_FORMAT=text
ATLAS_DATABASE_URL=postgres://atlas_api:atlas_api@localhost:55433/atlas?sslmode=disable
ATLAS_MIGRATE_DATABASE_URL=postgres://atlas_migrator:atlas_migrator@localhost:55433/atlas?sslmode=disable
ATLAS_PUBLIC_BASE_URL=http://localhost:8080

# ── Authentication and realtime tokens (§6.1, ADR-008) ───────
# Leave the two keys empty in local development: atlas-api generates ephemeral
# ones at boot. Staging and production must set them from the secret manager.
# Generate a persistent pair with `atlas-cli keygen` and paste it here.
ATLAS_SESSION_COOKIE=atlas_session
ATLAS_ENCRYPTION_KEY=
ATLAS_REALTIME_PRIVATE_KEY=
ATLAS_REALTIME_ISSUER=atlas
ATLAS_REALTIME_AUDIENCE=atlas-realtime
ATLAS_REALTIME_TOKEN_TTL=5m
ATLAS_SERVICE_AUDIENCE=atlas-internal

# ── Elixir orchestrator (atlas-orchestrator) ─────────────────
ORCHESTRATOR_DATABASE_URL=postgres://atlas_orchestrator:atlas_orchestrator@localhost:55433/atlas
ATLAS_API_INTERNAL_URL=http://localhost:8080
# Where the orchestrator fetches the public keys it verifies realtime tokens
# against (served by atlas-api; never exposed at the edge).
ATLAS_JWKS_URL=http://localhost:8080/internal/v1/.well-known/jwks.json
SECRET_KEY_BASE=dev-only-not-a-real-secret-replace-me-0000000000000000000000000000

# ── Next.js web ──────────────────────────────────────────────
# Leave EMPTY: the browser calls /api/* on its own origin (Caddy in
# production, the next.config.ts rewrite in development) so the session
# cookie stays first-party. Pointing this at :8080 makes the browser call Go
# cross-origin, which has no CORS, and sign-in fails (docs/FRONTEND.md §1).
NEXT_PUBLIC_API_BASE_URL=

# ── Edge (Caddy) ─────────────────────────────────────────────
ATLAS_SITE_ADDRESS=localhost
