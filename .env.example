# ─────────────────────────────────────────────────────────────
# Atlas — local development environment
# Copy to `.env` and adjust. NEVER commit a real `.env`.
#   PowerShell:  Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
# NOTE: Atlas deliberately does NOT use host port 5432 — that is commonly
# taken by another local Postgres/container. 55433 keeps Atlas isolated.
POSTGRES_HOST=localhost
POSTGRES_PORT=55433
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas

# Dedicated database roles created by infra/compose/postgres/initdb.d/01-roles.sh
ATLAS_API_DB_PASSWORD=atlas_api
ATLAS_ORCHESTRATOR_DB_PASSWORD=atlas_orchestrator
ATLAS_WORKER_DB_PASSWORD=atlas_worker
ATLAS_READONLY_DB_PASSWORD=atlas_readonly
ATLAS_MIGRATOR_DB_PASSWORD=atlas_migrator

# ── Object storage (SeaweedFS locally; S3-compatible in staging/prod) ──
# Local: SeaweedFS. MinIO community images were removed from Docker Hub in
# Sept 2026; see docs/adr/ADR-015-object-storage-provider.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=atlas
S3_SECRET_KEY=atlasminio
S3_BUCKET=atlas-files
S3_USE_SSL=false

# ── Email (Mailpit locally) ──────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=atlas@localhost

# ── Go core API (atlas-api / atlas-worker) ───────────────────
ATLAS_ENV=local
ATLAS_HTTP_ADDR=:8080
ATLAS_LOG_LEVEL=debug
ATLAS_LOG_FORMAT=text
ATLAS_DATABASE_URL=postgres://atlas_api:atlas_api@localhost:55433/atlas?sslmode=disable
ATLAS_MIGRATE_DATABASE_URL=postgres://atlas_migrator:atlas_migrator@localhost:55433/atlas?sslmode=disable
ATLAS_PUBLIC_BASE_URL=http://localhost:8080

# ── Approvals (§6.3) ─────────────────────────────────────────
# atlas-worker expires approvals past their deadline on a poll and fans out the
# expiry. Both values are configuration, not code; the defaults (1m, 100) are
# fine locally.
ATLAS_APPROVAL_SWEEP_INTERVAL=1m
ATLAS_APPROVAL_SWEEP_BATCH=100

# ── Work escalations (§3.2, §5.8) ────────────────────────────
# atlas-worker walks overdue tasks up the escalation ladder on a poll. Both
# values are configuration, not code; the defaults (1m, 100) are fine locally.
ATLAS_WORK_SWEEP_INTERVAL=1m
ATLAS_WORK_SWEEP_BATCH=100

# ── Daily reports (§8.5, decision D5) ────────────────────────
# atlas-worker sweeps the daily-report lifecycle on a poll: it opens each
# working day's report at the prompt time, marks what is still missing after
# the deadline, relabels late filings and escalates repeated misses. Both values
# are configuration, not code; the defaults (1m, 500) are fine locally. The
# policy itself (prompt/deadline time, working days, the miss rule) is typed
# settings, not environment: retune it through the settings API.
ATLAS_DAILY_REPORT_SWEEP_INTERVAL=1m
ATLAS_DAILY_REPORT_SWEEP_BATCH=500

# ── GitHub webhooks (§12, decision D6) ──────────────────────────────────────
# atlas-api verifies an inbound GitHub delivery's HMAC-SHA256 signature
# (X-Hub-Signature-256) against this shared secret before it links a merged PR
# to the task named by its Atlas ref and records pull_request evidence. Copy it
# from the repository's webhook. Empty leaves /webhooks/github answering 503 —
# never an unverified accept.
ATLAS_GITHUB_WEBHOOK_SECRET=

# ── Authentication and realtime tokens (§6.1, ADR-008) ───────
# Leave the two keys empty in local development: atlas-api generates ephemeral
# ones at boot. Staging and production must set them from the secret manager.
# Generate a persistent pair with `atlas-cli keygen` and paste it here.
ATLAS_SESSION_COOKIE=atlas_session
# How recently a session must have been seen to count as "online" in the people
# activity view (§8.5). Open clients send a heartbeat every minute, so this is
# much shorter than the session idle timeout; two minutes tolerates one miss.
ATLAS_SESSION_PRESENCE_WINDOW=2m
ATLAS_ENCRYPTION_KEY=
ATLAS_REALTIME_PRIVATE_KEY=
ATLAS_REALTIME_ISSUER=atlas
ATLAS_REALTIME_AUDIENCE=atlas-realtime
ATLAS_REALTIME_TOKEN_TTL=5m
ATLAS_SERVICE_AUDIENCE=atlas-internal
# Lifetime of a minted service token (`atlas-cli service token`). Service tokens
# are static, held by the caller, so this is long by design.
ATLAS_SERVICE_TOKEN_TTL=720h

# ── Elixir orchestrator (atlas-orchestrator) ─────────────────
ORCHESTRATOR_DATABASE_URL=postgres://atlas_orchestrator:atlas_orchestrator@localhost:55433/atlas
ATLAS_API_INTERNAL_URL=http://localhost:8080
# The orchestrator's service credential for internal Go calls. Create the
# identity once, then mint a token and paste it here:
#   atlas-cli service create --id svc:orchestrator \
#     --permission core.authz.check --permission core.notification.manage
#   atlas-cli service token --id svc:orchestrator
# (Run `atlas-cli keygen` first: the token is signed with the API's key, so an
# ephemeral key would mint a token the API cannot verify.) Empty disables
# orchestrator→Go internal calls.
ATLAS_SERVICE_TOKEN=
# Where the orchestrator fetches the public keys it verifies realtime tokens
# against (served by atlas-api; never exposed at the edge).
ATLAS_JWKS_URL=http://localhost:8080/internal/v1/.well-known/jwks.json
SECRET_KEY_BASE=dev-only-not-a-real-secret-replace-me-0000000000000000000000000000

# ── Next.js web ──────────────────────────────────────────────
# Leave EMPTY: the browser calls /api/* on its own origin (Caddy in
# production, the next.config.ts rewrite in development) so the session
# cookie stays first-party. Pointing this at :8080 makes the browser call Go
# cross-origin, which has no CORS, and sign-in fails (docs/FRONTEND.md §1).
NEXT_PUBLIC_API_BASE_URL=
# Phoenix Channels socket. Next.js rewrites cannot proxy WebSockets, so in
# development the browser must reach the orchestrator directly. Left empty,
# a dev build already uses ws://<host>:4000/socket; production uses /socket
# (Caddy proxies it). http(s):// is accepted and treated as ws(s)://.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000/socket

# ── Edge (Caddy) ─────────────────────────────────────────────
ATLAS_SITE_ADDRESS=localhost
